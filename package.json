{
  "name": "amazon-fba-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs --test tests/*.test.mjs",
    "test:integracao": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs --test tests-integracao/*.test.mjs",
    "ci:preparar-banco": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/ci-preparar-banco.mjs",
    "health:local": "node scripts/health-local.mjs",
    "migrate": "node scripts/migrate-cli.mjs guard",
    "migrate:plan": "node --env-file-if-exists=.env.local scripts/migrate-cli.mjs plan",
    "migrate:local": "node --env-file-if-exists=.env.local scripts/migrate-cli.mjs local",
    "migrate:apply": "node --env-file-if-exists=.env.local scripts/migrate-cli.mjs apply",
    "migrate:authorize": "node scripts/migration-authorize.mjs",
    "backfill:canonical": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs --env-file=.env.local scripts/backfill-canonical.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
