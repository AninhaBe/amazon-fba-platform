# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dados locais (custos cadastrados)
/data

# ngrok binario local
/.tools

# Ferramentas locais de agentes e referencias de design
/.agents
# .claude: versionar SÓ as skills que são nossas.
# O conhecimento operacional de Ads mora nelas e custou dias para ser levantado —
# perder isso é perder o histórico que o git não tem em nenhum outro lugar.
# Ficam de fora: settings.local.json (config local) e as skills bundled da Anthropic.
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/amazon-listing/
!/.claude/skills/gerenciar-ads/
!/.claude/skills/monitorar-ads/
/.codex
/ui-ux-pro-max-skill
/skills-lock.json

# Artefatos locais de auditoria visual
/.revenue-chart-check.png

# Crash dumps do Git Bash no Windows
bash.exe.stackdump
*.stackdump
