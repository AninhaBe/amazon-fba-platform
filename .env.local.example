# ---- Banco de dados (Supabase / PostgreSQL) ----
# Persiste contas conectadas e custos. Se vazio, cai no arquivo JSON local
# (dev). No Render/produção é obrigatório — sem ele os dados somem a cada deploy.
# Supabase: Project Settings > Database > Connection string > "Session pooler" (URI).
DATABASE_URL=

# ---- Autenticação Supabase (cookies SSR) ----
# Supabase > Project Settings > API (ou botão Connect).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Segurança dos tokens de integrações ----
# Chave longa e aleatória usada para criptografar tokens em repouso (obrigatória em produção).
# Gere uma única vez e mantenha o mesmo valor entre deploys.
INTEGRATION_TOKEN_KEY=

# ---- Mercado Livre Brasil (OAuth 2.0 + PKCE) ----
# Crie o app em https://developers.mercadolivre.com.br/ e habilite leitura.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Redirect URI exata a cadastrar no app:
# https://SEU_DOMINIO/api/integrations/mercado-livre/callback

# ---- TikTok Shop Partner API ----
# App criado no TikTok Shop Partner Center. NÃO comitar os valores reais.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Identificador do serviço exibido no app do Partner Center.
TIKTOK_SERVICE_ID=
# Compatibilidade com configurações antigas: URL copiada do Partner Center.
# Prefira TIKTOK_SERVICE_ID; se ambos existirem, o service_id acima prevalece.
TIKTOK_AUTH_URL=
# Redirect URL exata a cadastrar no app:
# https://SEU_DOMINIO/api/tiktok/callback

# ---- LWA (Login with Amazon) credentials do seu app SP-API ----
LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
LWA_CLIENT_SECRET=xxxxxxxx
LWA_REFRESH_TOKEN=Atzr|xxxxxxxx

# ---- Região da SP-API ----
# NA  -> https://sellingpartnerapi-na.amazon.com   (EUA, Canadá, México, BRASIL)
# EU  -> https://sellingpartnerapi-eu.amazon.com   (Europa, Índia)
# FE  -> https://sellingpartnerapi-fe.amazon.com   (Japão, Austrália, Singapura)
SPAPI_REGION=NA

# ---- Marketplace padrão ----
# Brasil = A2Q3Y263D00KWC | EUA = ATVPDKIKX0DER | Alemanha = A1PA6795UKMFR9
DEFAULT_MARKETPLACE_ID=A2Q3Y263D00KWC

# Use o endpoint sandbox (respostas de exemplo) em vez do de produção?
SPAPI_USE_SANDBOX=false

# ---- OAuth multi-conta (para colegas conectarem a própria conta) ----
# Application ID do seu app SP-API (Developer Central) — usado na tela de consentimento.
SPAPI_APP_ID=amzn1.sellerapps.app.xxxxxxxx
# Credenciais LWA do app do OAuth (se diferente do LWA_* acima). Se vazio, usa o LWA_*.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# URL pública HTTPS onde o app está rodando (redirect do OAuth). Em produção: https://seuapp.vercel.app
# Local: pode deixar em branco (usa a origem da requisição).
APP_BASE_URL=
APP_UI_BASE_URL=
# Seller Central do consentimento (Brasil).
SPAPI_SELLERCENTRAL_URL=https://sellercentral.amazon.com.br
# App ainda em rascunho? true adiciona version=beta ao consentimento (necessário p/ contas de teste).
SPAPI_APP_DRAFT=true

# ================================================================
# ---- Amazon Ads API (SEPARADA da SP-API — outro app/token) ----
# ================================================================
# Criados no seu app do Amazon Ads (Security Profile no developer.amazon.com)
ADS_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
ADS_CLIENT_SECRET=xxxxxxxx
# URL de retorno cadastrada no Security Profile (usada só para pegar o token)
ADS_REDIRECT_URI=https://localhost:3000/ads/callback
# Gerado pelos scripts de auth (scripts/ads-*.mjs)
ADS_REFRESH_TOKEN=Atzr|xxxxxxxx
# Descoberto por scripts/ads-profiles.mjs (a conta do Brasil)
ADS_PROFILE_ID=
# Endpoint da Ads API (Brasil usa o NA)
ADS_API_HOST=https://advertising-api.amazon.com
